<?xml version="1.0" encoding="utf-8"?>
<!-- TLS only. No user-installed CAs and no cleartext in any build type. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
